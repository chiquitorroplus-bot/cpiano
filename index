<script>
// ============================================================
// ESTADO GLOBAL
// ============================================================
const state = {
  midi: null,
  trackIndex: 0,
  events: [],
  currentStep: 0,
  midiAccess: null,
  inputDevice: null,
  expectedPitches: new Set(),
  pressedPitches: new Set(),
  practiceMode: false,
  stats: { correct: 0, errors: 0 },
  pianoRange: { low: 36, high: 84 }
};

const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

// ============================================================
// UTILIDADES
// ============================================================
function midiToName(midi) {
  const octave = Math.floor(midi / 12) - 1;
  return NOTE_NAMES[midi % 12] + octave;
}

function midiToVexFlow(midi) {
  const octave = Math.floor(midi / 12) - 1;
  const name = NOTE_NAMES[midi % 12];
  return name + '/' + octave;
}

function isBlackKey(midi) {
  const pc = midi % 12;
  return [1, 3, 6, 8, 10].includes(pc);
}

function ticksToDuration(ticks, ppq) {
  // Aproximar a la duración más cercana estándar
  const quarter = ppq;
  const ratios = [
    { type: 'w', ticks: quarter * 4 },
    { type: 'h', ticks: quarter * 2 },
    { type: 'q', ticks: quarter },
    { type: '8', ticks: quarter / 2 },
    { type: '16', ticks: quarter / 4 },
    { type: '32', ticks: quarter / 8 }
  ];
  let best = ratios[ratios.length - 1];
  let bestDiff = Math.abs(ticks - best.ticks);
  for (const r of ratios) {
    const d = Math.abs(ticks - r.ticks);
    if (d < bestDiff) {
      bestDiff = d;
      best = r;
    }
  }
  // Si la duración es muy corta, usar al menos 32
  if (ticks < quarter / 8) return '32';
  return best.type;
}

// ============================================================
// AUDIO (sintetizador simple para feedback)
// ============================================================
const audio = {
  ctx: null,
  master: null,

  init() {
    if (this.ctx) return;
    try {
      this.ctx = new (window.AudioContext || window.webkitAudioContext)();
      this.master = this.ctx.createGain();
      this.master.gain.value = 0.18;
      const reverb = this.ctx.createConvolver();
      // Reverb simple con ruido
      const len = this.ctx.sampleRate * 1.2;
      const buf = this.ctx.createBuffer(2, len, this.ctx.sampleRate);
      for (let ch = 0; ch < 2; ch++) {
        const data = buf.getChannelData(ch);
        for (let i = 0; i < len; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.5);
        }
      }
      reverb.buffer = buf;
      const wet = this.ctx.createGain();
      wet.gain.value = 0.25;
      this.master.connect(this.ctx.destination);
      this.master.connect(reverb);
      reverb.connect(wet);
      wet.connect(this.ctx.destination);
    } catch (e) {
      console.warn('Audio init failed', e);
    }
  },

  playNote(midi, duration = 0.6) {
    this.init();
    if (!this.ctx) return;
    if (this.ctx.state === 'suspended') this.ctx.resume();

    const freq = 440 * Math.pow(2, (midi - 69) / 12);
    const now = this.ctx.currentTime;

    const osc1 = this.ctx.createOscillator();
    osc1.type = 'triangle';
    osc1.frequency.value = freq;

    const osc2 = this.ctx.createOscillator();
    osc2.type = 'sine';
    osc2.frequency.value = freq * 2;

    const gain2 = this.ctx.createGain();
    gain2.gain.value = 0.15;

    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0, now);
    gain.gain.linearRampToValueAtTime(0.35, now + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

    osc1.connect(gain);
    osc2.connect(gain2);
    gain2.connect(gain);
    gain.connect(this.master);

    osc1.start(now);
    osc2.start(now);
    osc1.stop(now + duration + 0.1);
    osc2.stop(now + duration + 0.1);
  }
};

// ============================================================
// CARGA Y PARSEO DE MIDI
// ============================================================
async function loadMidiFile(file) {
  try {
    showToast('Procesando archivo MIDI...', 'info');
    const arrayBuffer = await file.arrayBuffer();
    const midi = new Midi(arrayBuffer);
    state.midi = midi;
    
    if (midi.tracks.length === 0) {
      showToast('El archivo MIDI no contiene pistas', 'error');
      return;
    }
    
    populateTrackSelector();
    selectBestTrack();
    prepareEvents();
    renderScore();
    renderPiano();
    updateNoteDisplay();
    updateStats();
    showToast(`Cargado: ${file.name}`, 'success');
  } catch (e) {
    console.error(e);
    showToast('Error al procesar el MIDI: ' + e.message, 'error');
  }
}

function populateTrackSelector() {
  const select = document.getElementById('track-select');
  select.innerHTML = '';
  state.midi.tracks.forEach((track, i) => {
    const opt = document.createElement('option');
    opt.value = i;
    const name = track.name || `Pista ${i + 1}`;
    const noteCount = track.notes.length;
    opt.textContent = `${name} (${noteCount} notas)`;
    if (noteCount === 0) opt.disabled = true;
    select.appendChild(opt);
  });
}

function selectBestTrack() {
  let bestIdx = 0;
  let bestCount = 0;
  state.midi.tracks.forEach((track, i) => {
    if (track.notes.length > bestCount) {
      bestCount = track.notes.length;
      bestIdx = i;
    }
  });
  state.trackIndex = bestIdx;
  document.getElementById('track-select').value = bestIdx;
}

function prepareEvents() {
  const track = state.midi.tracks[state.trackIndex];
  if (!track || !track.notes.length) {
    state.events = [];
    return;
  }
  
  const sortedNotes = [...track.notes].sort((a, b) => a.ticks - b.ticks);
  const events = [];
  let currentEvent = null;
  const tickTol = Math.max(1, state.midi.header.ppq / 4); // 1/16 de nota

  for (const note of sortedNotes) {
    if (!currentEvent || Math.abs(note.ticks - currentEvent.ticks) > tickTol) {
      currentEvent = {
        ticks: note.ticks,
        time: note.time,
        duration: note.duration,
        durationTicks: note.durationTicks,
        pitches: [note.midi]
      };
      events.push(currentEvent);
    } else {
      if (!currentEvent.pitches.includes(note.midi)) {
        currentEvent.pitches.push(note.midi);
      }
      currentEvent.durationTicks = Math.max(currentEvent.durationTicks, note.durationTicks);
    }
  }
  state.events = events;
}

// ============================================================
// RENDERIZADO DEL PENTAGRAMA (VexFlow)
// ============================================================
function renderScore() {
  const container = document.getElementById('score-container');
  container.innerHTML = '';

  if (!state.events || state.events.length === 0) {
    container.innerHTML = '<div class="empty-state"><div class="icon">𝄞</div><h3>Esta pista no tiene notas</h3><p>Selecciona otra pista en el selector superior.</p></div>';
    return;
  }

  const VF = Vex.Flow;
  const ppq = state.midi.header.ppq || 480;
  const ts = state.midi.header.timeSignatures[0];
  const beatsPerBar = ts ? ts.timeSignature[0] : 4;
  const beatUnit = ts ? ts.timeSignature[1] : 4;
  const ticksPerBar = ppq * 4 * beatsPerBar / beatUnit;

  // Asignar eventos a compases
  const bars = [];
  for (const ev of state.events) {
    const barIdx = Math.floor(ev.ticks / ticksPerBar);
    if (!bars[barIdx]) bars[barIdx] = [];
    bars[barIdx].push(ev);
  }
  for (let i = 0; i < bars.length; i++) {
    if (!bars[i]) bars[i] = [];
  }

  const maxBars = Math.min(bars.length, 150);
  const barsToShow = bars.slice(0, maxBars);

  const barsPerStave = 4;
  const numStaves = Math.ceil(barsToShow.length / barsPerStave);

  const containerWidth = Math.max(container.clientWidth, 700);
  const staveWidth = containerWidth - 120;
  const staveHeight = 130;
  const staveGap = 36;
  const totalHeight = numStaves * (staveHeight + staveGap) + 40;

  const renderer = new VF.Renderer(container, VF.Renderer.Backends.SVG);
  renderer.resize(containerWidth, totalHeight);
  const context = renderer.getContext();
  context.setFont('Space Grotesk', 10);
  context.setFillStyle('#2a1f15');
  context.setStrokeStyle('#2a1f15');

  let y = 20;
  let eventIdx = 0;

  for (let s = 0; s < numStaves; s++) {
    const staveBars = barsToShow.slice(s * barsPerStave, (s + 1) * barsPerStave);
    if (staveBars.length === 0) break;

    const xStart = 20;
    const stave = new VF.Stave(xStart, y, staveWidth);
    if (s === 0) {
      stave.addClef('treble').addTimeSignature(`${beatsPerBar}/${beatUnit}`);
    } else {
      stave.addClef('treble');
    }
    stave.setContext(context).draw();

    const notes = [];
    const noteIdxMap = new Map(); // mapea note -> eventIdx

    for (let b = 0; b < staveBars.length; b++) {
      const barEvents = staveBars[b];
      if (!barEvents || barEvents.length === 0) {
        // Silencio de compás completo
        const restDur = beatsPerBar === 4 ? 'wr' : (beatsPerBar === 3 ? 'hd' : 'wr');
        const rest = new VF.StaveNote({ keys: ['d/5'], duration: 'wr' });
        notes.push(rest);
      } else {
        for (const ev of barEvents) {
          const sortedPitches = [...ev.pitches].sort((a, b) => a - b);
          const keys = sortedPitches.map(midiToVexFlow);
          const dur = ticksToDuration(ev.durationTicks, ppq);
          const note = new VF.StaveNote({
            keys: keys,
            duration: dur,
            auto_stem: true
          });

          sortedPitches.forEach((p, idx) => {
            const pc = p % 12;
            if ([1, 3, 6, 8, 10].includes(pc)) {
              note.addAccidental(idx, new VF.Accidental('#'));
            }
          });

          // ID para highlight
          try {
            note.setAttribute('id', 'vf-note-' + eventIdx);
          } catch (e) {}
          noteIdxMap.set(note, eventIdx);
          eventIdx++;

          notes.push(note);
        }
      }
    }

    if (notes.length === 0) {
      y += staveHeight + staveGap;
      continue;
    }

    const totalBeats = beatsPerBar * staveBars.length;
    const voice = new VF.Voice({ num_beats: totalBeats, beat_value: beatUnit });
    voice.setStrict(false);
    voice.addTickables(notes);

    try {
      new VF.Formatter().joinVoices([voice]).format([voice], staveWidth - 100);
    } catch (e) {
      console.warn('Format error', e);
      new VF.Formatter().format([voice], staveWidth - 100);
    }

    try {
      if (VF.Beam && VF.Beam.applyBeams) VF.Beam.applyBeams(voice);
    } catch (e) {}

    voice.draw(context, stave);

    y += staveHeight + staveGap;
  }

  // Aplicar highlight inicial
  highlightCurrentNote();
}

function highlightCurrentNote() {
  // Limpiar
  document.querySelectorAll('.vf-stavenote.current-note, .vf-stavenote.played-note').forEach(el => {
    el.classList.remove('current-note', 'played-note');
  });

  if (!state.events.length) return;

  // Marcar notas ya tocadas
  for (let i = 0; i < state.currentStep; i++) {
    const el = document.getElementById('vf-note-' + i);
    if (el) el.classList.add('played-note');
  }

  // Marcar nota actual
  const el = document.getElementById('vf-note-' + state.currentStep);
  if (el) {
    el.classList.add('current-note');
    // Scroll suave
    if (state.practiceMode) {
      try {
        el.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
      } catch (e) {}
    }
  }
}

// ============================================================
// RENDERIZADO DEL TECLADO DE PIANO
// ============================================================
function renderPiano() {
  const piano = document.getElementById('piano');
  piano.innerHTML = '';

  // Calcular rango basado en las notas del MIDI
  let lowNote = 36; // C2
  let highNote = 84; // C6
  if (state.events.length) {
    const allPitches = state.events.flatMap(e => e.pitches);
    if (allPitches.length) {
      lowNote = Math.min(...allPitches) - 2;
      highNote = Math.max(...allPitches) + 2;
      // Asegurar que empiece en C
      while (lowNote % 12 !== 0) lowNote--;
      while (highNote % 12 !== 0) highNote++;
      lowNote = Math.max(21, lowNote);
      highNote = Math.min(108, highNote);
    }
  }
  state.pianoRange = { low: lowNote, high: highNote };

  // Recoger teclas blancas
  const whiteKeys = [];
  for (let n = lowNote; n <= highNote; n++) {
    if (!isBlackKey(n)) whiteKeys.push(n);
  }

  const whiteKeysContainer = document.createElement('div');
  whiteKeysContainer.className = 'white-keys';

  whiteKeys.forEach((n, i) => {
    const key = document.createElement('div');
    key.className = 'key white';
    key.dataset.midi = n;
    const name = midiToName(n);
    const label = document.createElement('span');
    label.className = 'key-label';
    if (n % 12 === 0) {
      label.textContent = name;
      label.classList.add('octave');
    }
    key.appendChild(label);
    key.addEventListener('mousedown', () => handleVirtualPress(n, true));
    key.addEventListener('mouseup', () => handleVirtualPress(n, false));
    key.addEventListener('mouseleave', () => handleVirtualPress(n, false));
    key.addEventListener('touchstart', (e) => { e.preventDefault(); handleVirtualPress(n, true); });
    key.addEventListener('touchend', (e) => { e.preventDefault(); handleVirtualPress(n, false); });
    whiteKeysContainer.appendChild(key);
  });
  piano.appendChild(whiteKeysContainer);

  // Teclas negras
  const blackKeysContainer = document.createElement('div');
  blackKeysContainer.className = 'black-keys';
  
  const whiteKeyWidth = 42; // px, debe coincidir con CSS
  let whiteIdx = -1;
  for (let n = lowNote; n <= highNote; n++) {
    if (!isBlackKey(n)) {
      whiteIdx++;
    } else {
      const key = document.createElement('div');
      key.className = 'key black';
      key.dataset.midi = n;
      key.style.left = ((whiteIdx + 1) * whiteKeyWidth - whiteKeyWidth * 0.3) + 'px';
      key.addEventListener('mousedown', () => handleVirtualPress(n, true));
      key.addEventListener('mouseup', () => handleVirtualPress(n, false));
      key.addEventListener('mouseleave', () => handleVirtualPress(n, false));
      key.addEventListener('touchstart', (e) => { e.preventDefault(); handleVirtualPress(n, true); });
      key.addEventListener('touchend', (e) => { e.preventDefault(); handleVirtualPress(n, false); });
      blackKeysContainer.appendChild(key);
    }
  }
  piano.appendChild(blackKeysContainer);
}

function handleVirtualPress(midi, down) {
  audio.init();
  if (down) {
    onNotePressed(midi, true);
  } else {
    onNoteReleased(midi, true);
  }
}

function highlightPianoKeys() {
  // Limpiar
  document.querySelectorAll('.key.expected').forEach(el => el.classList.remove('expected'));
  
  if (!state.practiceMode) return;
  
  // Resaltar notas esperadas
  state.expectedPitches.forEach(p => {
    const key = document.querySelector(`.key[data-midi="${p}"]`);
    if (key) key.classList.add('expected');
  });

  // Scroll del piano para mostrar la nota
  if (state.expectedPitches.size > 0) {
    const firstExpected = Math.min(...state.expectedPitches);
    const key = document.querySelector(`.key[data-midi="${firstExpected}"]`);
    if (key) {
      const scrollContainer = document.querySelector('.piano-scroll');
      const keyRect = key.getBoundingClientRect();
      const containerRect = scrollContainer.getBoundingClientRect();
      if (keyRect.left < containerRect.left || keyRect.right > containerRect.right) {
        key.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    }
  }
}

// ============================================================
// WEB MIDI API
// ============================================================
async function connectMidi() {
  if (!navigator.requestMIDIAccess) {
    showToast('Tu navegador no soporta Web MIDI API. Usa Chrome, Edge u Opera.', 'error');
    return;
  }
  try {
    const access = await navigator.requestMIDIAccess();
    state.midiAccess = access;
    setupMidiInputs();
    access.onstatechange = () => setupMidiInputs();
    showMidiModal();
  } catch (e) {
    showToast('Error al acceder a MIDI: ' + e.message, 'error');
  }
}

function setupMidiInputs() {
  const select = document.getElementById('midi-input-select');
  select.innerHTML = '';
  const inputs = state.midiAccess.inputs;
  
  if (inputs.size === 0) {
    select.innerHTML = '<option value="">No hay dispositivos MIDI</option>';
    return;
  }
  
  let firstId = null;
  inputs.forEach((input, id) => {
    const opt = document.createElement('option');
    opt.value = id;
    opt.textContent = input.name + (input.manufacturer ? ' (' + input.manufacturer + ')' : '');
    select.appendChild(opt);
    if (!firstId) firstId = id;
  });
  
  if (state.inputDevice) {
    select.value = state.inputDevice.id;
  } else if (firstId) {
    select.value = firstId;
  }
}

function showMidiModal() {
  document.getElementById('midi-modal').classList.add('active');
}

function hideMidiModal() {
  document.getElementById('midi-modal').classList.remove('active');
}

function connectToSelectedInput() {
  const select = document.getElementById('midi-input-select');
  const inputId = select.value;
  if (!inputId) {
    showToast('Selecciona un dispositivo', 'error');
    return;
  }
  
  if (state.inputDevice) {
    state.inputDevice.onmidimessage = null;
  }
  
  state.inputDevice = state.midiAccess.inputs.get(inputId);
  state.inputDevice.onmidimessage = handleMidiMessage;
  
  document.getElementById('midi-dot').classList.add('connected');
  document.getElementById('midi-status-text').textContent = state.inputDevice.name;
  hideMidiModal();
  showToast(`Conectado: ${state.inputDevice.name}`, 'success');
}

function handleMidiMessage(message) {
  const [status, note, velocity] = message.data;
  const command = status & 0xf0;
  
  if (command === 0x90 && velocity > 0) {
    onNotePressed(note, false);
  } else if (command === 0x80 || (command === 0x90 && velocity === 0)) {
    onNoteReleased(note, false);
  }
}

// ============================================================
// LÓGICA DE PRÁCTICA
// ============================================================
function togglePracticeMode() {
  state.practiceMode = document.getElementById('practice-toggle').checked;
  if (state.practiceMode) {
    startPractice();
  } else {
    stopPractice();
  }
}

function startPractice() {
  if (!state.events.length) {
    showToast('Carga un archivo MIDI primero', 'error');
    document.getElementById('practice-toggle').checked = false;
    state.practiceMode = false;
    return;
  }
  audio.init();
  state.currentStep = 0;
  state.stats = { correct: 0, errors: 0 };
  state.expectedPitches = new Set(state.events[0].pitches);
  state.pressedPitches.clear();
  highlightCurrentNote();
  highlightPianoKeys();
  updateNoteDisplay();
  updateStats();
  showToast('Modo práctica activado. Toca las notas resaltadas.', 'info');
}

function stopPractice() {
  state.practiceMode = false;
  state.expectedPitches.clear();
  state.pressedPitches.clear();
  document.querySelectorAll('.key.expected').forEach(el => el.classList.remove('expected'));
  showToast('Modo práctica desactivado', 'info');
}

function onNotePressed(midi, isVirtual) {
  audio.init();
  // Feedback visual inmediato
  const key = document.querySelector(`.key[data-midi="${midi}"]`);
  if (key) key.classList.add('pressed');
  
  // Sonido de feedback
  audio.playNote(midi, 0.8);
  
  if (!state.practiceMode || !state.events.length) return;
  
  state.pressedPitches.add(midi);
  
  if (state.expectedPitches.has(midi)) {
    // Nota correcta
    if (key) {
      key.classList.add('correct');
      createRipple(key);
    }
    
    // Verificar si todas las notas esperadas han sido tocadas
    const allPlayed = [...state.expectedPitches].every(p => state.pressedPitches.has(p));
    if (allPlayed) {
      state.stats.correct++;
      updateStats();
      // Avanzar después de un pequeño delay
      setTimeout(() => advanceStep(), 280);
    }
  } else {
    // Nota incorrecta
    if (key) key.classList.add('error');
    state.stats.errors++;
    updateStats();
    showToast(`Incorrecto: ${midiToName(midi)}. Esperaba: ${[...state.expectedPitches].map(midiToName).join(', ')}`, 'error');
  }
}

function onNoteReleased(midi, isVirtual) {
  const key = document.querySelector(`.key[data-midi="${midi}"]`);
  if (key) {
    key.classList.remove('pressed', 'correct', 'error');
  }
  state.pressedPitches.delete(midi);
}

function advanceStep() {
  state.currentStep++;
  state.pressedPitches.clear();
  
  // Limpiar highlights
  document.querySelectorAll('.key.expected, .key.correct').forEach(el => {
    el.classList.remove('expected', 'correct');
  });
  
  if (state.currentStep >= state.events.length) {
    showToast('¡Completado! Has tocado toda la pieza.', 'success');
    state.practiceMode = false;
    document.getElementById('practice-toggle').checked = false;
    state.expectedPitches.clear();
    highlightCurrentNote();
    updateNoteDisplay();
    return;
  }
  
  state.expectedPitches = new Set(state.events[state.currentStep].pitches);
  highlightCurrentNote();
  highlightPianoKeys();
  updateNoteDisplay();
  updateStats();
}

function createRipple(element) {
  const rect = element.getBoundingClientRect();
  const ripple = document.createElement('div');
  ripple.className = 'ripple';
  ripple.style.left = (rect.left + rect.width / 2 - 100) + 'px';
  ripple.style.top = (rect.top + rect.height / 2 - 100) + 'px';
  document.getElementById('ripple-container').appendChild(ripple);
  setTimeout(() => ripple.remove(), 800);
}

// ============================================================
// UI Y FEEDBACK
// ============================================================
function showToast(msg, type = 'info') {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = 'toast ' + type;
  toast.textContent = msg;
  container.appendChild(toast);
  setTimeout(() => toast.remove(), 3200);
}

function updateNoteDisplay() {
  const el = document.getElementById('now-playing-note');
  if (!state.events.length) {
    el.textContent = '—';
    return;
  }
  if (state.currentStep >= state.events.length) {
    el.textContent = '✓';
    return;
  }
  const ev = state.events[state.currentStep];
  const names = ev.pitches.map(midiToName).join(' + ');
  el.textContent = names;
}

function updateStats() {
  document.getElementById('stat-correct').textContent = state.stats.correct;
  document.getElementById('stat-errors').textContent = state.stats.errors;
  const total = state.events.length;
  const current = Math.min(state.currentStep, total);
  document.getElementById('stat-progress').textContent = `${current} / ${total}`;
  const pct = total > 0 ? (current / total) * 100 : 0;
  document.getElementById('progress-fill').style.width = pct + '%';
}

// ============================================================
// EJEMPLO MIDI GENERADO
// ============================================================
function writeVarLen(value) {
  const bytes = [];
  bytes.unshift(value & 0x7f);
  value >>= 7;
  while (value > 0) {
    bytes.unshift((value & 0x7f) | 0x80);
    value >>= 7;
  }
  return bytes;
}

function generateExampleMidi() {
  // "Ode to Joy" de Beethoven - melodía simple
  // Notas: E4=64, F4=65, G4=67, A4=69, B4=71, C5=72, D5=74
  const melody = [
    { midi: 64, dur: 1 }, { midi: 64, dur: 1 }, { midi: 65, dur: 1 }, { midi: 67, dur: 1 },
    { midi: 67, dur: 1 }, { midi: 65, dur: 1 }, { midi: 64, dur: 1 }, { midi: 62, dur: 1 },
    { midi: 60, dur: 1 }, { midi: 60, dur: 1 }, { midi: 62, dur: 1 }, { midi: 64, dur: 1 },
    { midi: 64, dur: 1.5 }, { midi: 62, dur: 0.5 }, { midi: 62, dur: 2 },
    { midi: 64, dur: 1 }, { midi: 64, dur: 1 }, { midi: 65, dur: 1 }, { midi: 67, dur: 1 },
    { midi: 67, dur: 1 }, { midi: 65, dur: 1 }, { midi: 64, dur: 1 }, { midi: 62, dur: 1 },
    { midi: 60, dur: 1 }, { midi: 60, dur: 1 }, { midi: 62, dur: 1 }, { midi: 64, dur: 1 },
    { midi: 62, dur: 1.5 }, { midi: 60, dur: 0.5 }, { midi: 60, dur: 2 }
  ];

  const ppq = 480;
  const events = [];
  
  // Tempo (120 BPM = 500000 us per quarter)
  events.push({ delta: 0, data: [0xFF, 0x51, 0x03, 0x07, 0xA1, 0x20] });
  // Time signature 4/4
  events.push({ delta: 0, data: [0xFF, 0x58, 0x04, 0x04, 0x02, 0x18, 0x08] });
  // Track name
  const nameStr = "Ode to Joy";
  const nameBytes = [0xFF, 0x03, nameStr.length, ...Array.from(nameStr).map(c => c.charCodeAt(0))];
  events.push({ delta: 0, data: nameBytes });

  for (const note of melody) {
    const durTicks = Math.round(note.dur * ppq);
    events.push({ delta: 0, data: [0x90, note.midi, 80] });
    events.push({ delta: durTicks, data: [0x80, note.midi, 0] });
  }
  events.push({ delta: 0, data: [0xFF, 0x2F, 0x00] });

  const trackBytes = [];
  for (const ev of events) {
    trackBytes.push(...writeVarLen(ev.delta));
    trackBytes.push(...ev.data);
  }

  const header = [
    0x4D, 0x54, 0x68, 0x64,
    0x00, 0x00, 0x00, 0x06,
    0x00, 0x00,
    0x00, 0x01,
    (ppq >> 8) & 0xff, ppq & 0xff
  ];

  const trackLength = trackBytes.length;
  const trackHeader = [
    0x4D, 0x54, 0x72, 0x6B,
    (trackLength >> 24) & 0xff,
    (trackLength >> 16) & 0xff,
    (trackLength >> 8) & 0xff,
    trackLength & 0xff
  ];

  return new Uint8Array([...header, ...trackHeader, ...trackBytes]);
}

async function loadExample() {
  const bytes = generateExampleMidi();
  const blob = new Blob([bytes], { type: 'audio/midi' });
  const file = new File([blob], 'ode-to-joy.mid', { type: 'audio/midi' });
  await loadMidiFile(file);
}

// ============================================================
// INICIALIZACIÓN
// ============================================================
function init() {
  // Verificar que las librerías estén cargadas
  function waitForLibs(cb) {
    if (window.Midi && window.Vex && window.Vex.Flow) {
      cb();
    } else {
      setTimeout(() => waitForLibs(cb), 50);
    }
  }

  waitForLibs(() => {
    // Listo
    renderPiano(); // Renderizar piano vacío inicial
    
    // Detectar soporte MIDI
    if (!navigator.requestMIDIAccess) {
      document.getElementById('midi-status-text').textContent = 'Web MIDI no soportado';
    }
  });

  // Event listeners
  document.getElementById('load-midi-btn').addEventListener('click', () => {
    document.getElementById('midi-file-input').click();
  });

  document.getElementById('midi-file-input').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) loadMidiFile(file);
  });

  document.getElementById('load-example-btn').addEventListener('click', loadExample);

  document.getElementById('practice-toggle').addEventListener('change', togglePracticeMode);

  document.getElementById('track-select').addEventListener('change', (e) => {
    state.trackIndex = parseInt(e.target.value);
    state.currentStep = 0;
    state.stats = { correct: 0, errors: 0 };
    state.expectedPitches.clear();
    state.pressedPitches.clear();
    if (state.practiceMode) {
      startPractice();
    } else {
      prepareEvents();
      renderScore();
      renderPiano();
      updateNoteDisplay();
      updateStats();
    }
  });

  document.getElementById('connect-midi-btn').addEventListener('click', connectMidi);
  document.getElementById('midi-modal-cancel').addEventListener('click', hideMidiModal);
  document.getElementById('midi-modal-connect').addEventListener('click', connectToSelectedInput);

  document.getElementById('midi-modal').addEventListener('click', (e) => {
    if (e.target.id === 'midi-modal') hideMidiModal();
  });

  // Resize observer para re-renderizar el pentagrama
  let resizeTimer;
  const ro = new ResizeObserver(() => {
    if (!state.events.length) return;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => renderScore(), 300);
  });
  ro.observe(document.getElementById('score-container'));

  // Atajos de teclado
  document.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && state.events.length) {
      e.preventDefault();
      const toggle = document.getElementById('practice-toggle');
      toggle.checked = !toggle.checked;
      togglePracticeMode();
    }
  });
}

init();
</script>

